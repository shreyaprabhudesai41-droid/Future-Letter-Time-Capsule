{
  "name": "Future Letter - Your Time Capsule",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Future Letter - Your Time Capsule",
        "formDescription": "Write a letter to your future self and choose when it should arrive.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Name",
              "fieldName": "name",
              "requiredField": false
            },
            {
              "fieldLabel": "Email",
              "fieldName": "email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Email Subject",
              "fieldName": "subject",
              "requiredField": true
            },
            {
              "fieldLabel": "Letter",
              "fieldName": "message",
              "fieldType": "textarea",
              "requiredField": true
            },
            {
              "fieldLabel": "Written On",
              "fieldName": "writtenOn",
              "requiredField": true
            },
            {
              "fieldLabel": "Delivery Date and Time",
              "fieldName": "deliveryTime",
              "fieldType": "date",
              "requiredField": true
            },
            {
              "fieldLabel": "Attachment Binary Property Name (optional)",
              "fieldName": "attachmentKeys",
              "requiredField": false
            }
          ]
        },
        "options": {}
      },
      "id": "4b2f0d6d-08e6-4f6d-9a26-futureletterform",
      "name": "Time Capsule Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        240,
        96
      ],
      "webhookId": "future-letter-form-webhook-placeholder"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst data = item.json;\nconst delivery = new Date(data.deliveryTime);\nif (Number.isNaN(delivery.getTime())) throw new Error('Please provide a valid delivery date and time.');\nif (delivery.getTime() < Date.now()) throw new Error('Delivery date and time must be in the future.');\nreturn [{ json: { ...data, deliveryTimeISO: delivery.toISOString() }, binary: item.binary }];"
      },
      "id": "a1a3e9cb-93d3-4c3e-9a8d-futurelettercalc",
      "name": "Calculate Delivery Time",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        96
      ]
    },
    {
      "parameters": {
        "resume": "specificTime",
        "dateTime": "={{ $json.deliveryTimeISO }}"
      },
      "id": "7ce0fced-48e9-44d8-bd63-futureletterwait",
      "name": "Wait Until Delivery Time",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        672,
        96
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "a8b7d2e1-0d5c-4d8b-9f44-futurelettercondition",
              "leftValue": "={{ Object.keys($binary || {}).length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "85e92501-5c86-4fb6-ad4a-2f2cb03b8bb3",
      "name": "Has Photos or Videos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        864,
        96
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "=Hi {{ $json.name || 'there' }},\n\nYou wrote this letter on {{ $json.writtenOn }} and asked for it to arrive now.\n\n----------------------------------------\n{{ $json.message }}\n----------------------------------------\n\nSent by Future Letter – your time capsule.",
        "options": {
          "appendAttribution": false,
          "attachmentsUi": {
            "attachmentsBinary": [
              {
                "property": "={{ $json.attachmentKeys || Object.keys($binary || {})[0] }}"
              }
            ]
          },
          "senderName": "Future Letter"
        }
      },
      "id": "1f912d72-d408-4669-a721-50e077dc71f1",
      "name": "Send Capsule With Files",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1104,
        0
      ],
      "credentials": {}
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "=Hi {{ $json.name || 'there' }},\n\nYou wrote this letter on {{ $json.writtenOn }} and asked for it to arrive now.\n\n----------------------------------------\n{{ $json.message }}\n----------------------------------------\n\nSent by Future Letter – your time capsule.",
        "options": {
          "appendAttribution": false,
          "senderName": "Future Letter"
        }
      },
      "id": "078db0aa-bfab-4fdc-b3c0-d454d4f2658f",
